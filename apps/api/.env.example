# ---------------------------------------------------------------------------
# API Teranga Fleet : copier vers .env et adapter. Ne jamais versionner .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Origines autorisées, séparées par des virgules. Obligatoire en production.
CORS_ORIGINS=http://localhost:3001

# PostgreSQL : conteneur Docker du projet (pnpm db:up), identifiants de dev uniquement
DATABASE_URL=postgresql://teranga:teranga_dev@localhost:5436/teranga_fleet?schema=public

# Mot de passe des comptes créés par le seed de développement (pnpm db:seed).
# Laisser vide pour en générer un aléatoire, affiché à la fin du seed.
SEED_PASSWORD=

# Authentification JWT (phase 3). Générer un secret long et aléatoire avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Stockage des fichiers (phase 6) : local en développement, s3 en production
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10

# Stockage S3-compatible (production)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# Seuil en jours des alertes "expire bientôt" et "entretien à prévoir"
ALERT_THRESHOLD_DAYS=30

# Marge en km avant le prochain entretien pour déclencher l'alerte "bientôt"
MAINTENANCE_KM_MARGIN=1000

# Tentatives de connexion / inscription autorisées par minute et par IP
AUTH_RATE_LIMIT=10

# Documentation Swagger sur /docs (par défaut : active hors production)
# SWAGGER_ENABLED=true

# Proxies de confiance pour l IP réelle du client (relais Next.js, reverse proxy).
# loopback : même machine. En production derrière Nginx/Traefik, indiquer son IP ou 1.
TRUST_PROXY=loopback
