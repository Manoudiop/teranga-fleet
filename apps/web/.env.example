# URL de l'API NestJS, utilisée UNIQUEMENT côté serveur Next.js (relais /api/*).
# Le navigateur ne la connaît pas et ne voit jamais le token : il est stocké dans un
# cookie httpOnly posé par Next.js.
API_URL=http://localhost:4000

# Suivi des erreurs Sentry (optionnel). SENTRY_DSN : serveur Next.js.
# NEXT_PUBLIC_SENTRY_DSN : navigateur, intégré au build (relancer le build après modification).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
